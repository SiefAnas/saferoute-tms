# Copy to .env and fill in. NEVER commit .env (spec §4: secrets in env only).

# PostgreSQL connection — matches docker-compose.yml defaults.
DATABASE_URL=postgres://saferoute:saferoute@localhost:5432/saferoute_dev

# Production guard. The API, the migration scripts, the seed and the e2e script all refuse a
# DATABASE_URL whose host isn't localhost / 127.0.0.1 / ::1, and print the host they were about
# to reach. Set ALLOW_PRODUCTION_DB=yes (exactly "yes") only where reaching that database is the
# point: on the Render API service, or in the one command you run against production on purpose:
#   ALLOW_PRODUCTION_DB=yes npm run migrate:up
# Leave it out of this file, so a laptop never talks to production by accident.
# ALLOW_PRODUCTION_DB=

# App
NODE_ENV=development
PORT=4000

# Auth (used in STEP 2). Generate a long random secret; keep it out of git.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=12h

# Email transport, picked in this order:
#   RESEND_API_KEY set -> Resend's HTTP API over HTTPS (works where outgoing SMTP is blocked)
#   SMTP_HOST set      -> SMTP via nodemailer
#   neither            -> dev transport (console log + in-memory recording, no real send)
# NODE_ENV=test always uses the dev transport regardless of these values.
# Every send gives up after MAIL_TIMEOUT_MS (default 15000) and logs why.
RESEND_API_KEY=
MAIL_TIMEOUT_MS=15000
# Bounce webhook (POST /webhooks/email-bounce): the signing secret ("whsec_...") of a Resend
# webhook subscribed to email.bounced. Unset = the endpoint answers 404.
RESEND_WEBHOOK_SECRET=
# Example values for Resend's SMTP endpoint (https://resend.com/docs/send-with-smtp):
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=resend
#   SMTP_PASS=<your Resend API key>
#   MAIL_FROM=SafeTurns <you@yourverifieddomain.com>
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
