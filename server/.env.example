# Copy to .env and fill in. NEVER commit .env (spec §4: secrets in env only).

# PostgreSQL connection — matches docker-compose.yml defaults.
DATABASE_URL=postgres://saferoute:saferoute@localhost:5432/saferoute_dev

# App
NODE_ENV=development
PORT=4000

# Auth (used in STEP 2). Generate a long random secret; keep it out of git.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=12h

# Email transport. Leave SMTP_HOST unset to use the dev transport (console log + in-memory
# recording, no real send). Set it to activate real sending via nodemailer. NODE_ENV=test
# always uses the dev transport regardless of these values.
# Example values for Resend's SMTP endpoint (https://resend.com/docs/send-with-smtp):
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=resend
#   SMTP_PASS=<your Resend API key>
#   MAIL_FROM=SafeRoute TMS <you@yourverifieddomain.com>
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
